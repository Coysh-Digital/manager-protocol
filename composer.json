{
    "name": "coysh-digital/manager-protocol",
    "description": "Wire contract shared by the Manager platform and the Manager Connector for Craft CMS.",
    "version": "1.6.0",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "manager",
        "protocol",
        "ed25519",
        "craftcms"
    ],
    "support": {
        "email": "support@managerforcraft.com",
        "source": "https://github.com/Coysh-Digital/manager-protocol"
    },
    "authors": [
        {
            "name": "Coysh Digital",
            "homepage": "https://coysh.digital"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "ext-sodium": "*"
    },
    "require-dev": {
        "pestphp/pest": "^3.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "coyshdigital\\managerprotocol\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "coyshdigital\\managerprotocol\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "pest",
        "phpstan": "phpstan analyse --memory-limit=1G"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
